{
  "name": "securechat-desktop",
  "productName": "SecureChat",
  "version": "1.3.1",
  "description": "SecureChat para Windows: mensajería con cifrado de extremo a extremo",
  "author": "Alejandro Zapata",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "copiar-web": "node scripts/copiar-web.js",
    "start": "npm run copiar-web && electron .",
    "build": "npm run copiar-web && electron-builder --win nsis portable --publish never && node scripts/firmar-actualizacion.js",
    "build:mac": "npm run copiar-web && electron-builder --mac --publish never",
    "build:linux": "npm run copiar-web && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "45.4.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "es.securechat.desktop",
    "productName": "SecureChat",
    "copyright": "Alejandro Zapata",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "actualizaciones.js",
      "actualizaciones-firma.js",
      "icon.png",
      "app/**/*",
      "!app/sw.js"
    ],
    "asar": true,
    "afterPack": "scripts/fusibles.js",
    "win": {
      "icon": "icon.png",
      "artifactName": "SecureChat-Windows-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SecureChat",
      "artifactName": "SecureChat-Windows-Instalador.${ext}"
    },
    "portable": {
      "artifactName": "SecureChat-Windows-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ZaperMaster",
        "repo": "securechat",
        "releaseType": "release"
      }
    ],
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "SecureChat-Mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "SecureChat usa el micrófono para las llamadas y las notas de voz.",
        "NSCameraUsageDescription": "SecureChat usa la cámara para las videollamadas."
      }
    },
    "dmg": {
      "artifactName": "SecureChat-Mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "icon.png",
      "category": "Network",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "ZaperMaster <197987728+ZaperMaster@users.noreply.github.com>",
      "synopsis": "Mensajería cifrada de extremo a extremo",
      "artifactName": "SecureChat-Linux.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  },
  "homepage": "https://zapermaster.github.io/securechat/"
}
