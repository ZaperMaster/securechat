{
  "name": "securechat-desktop",
  "productName": "SecureChat",
  "version": "1.1.1",
  "description": "SecureChat para Windows: mensajería con cifrado de extremo a extremo",
  "author": "Alejandro Zapata",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "copiar-web": "node scripts/copiar-web.js",
    "start": "npm run copiar-web && electron .",
    "build": "npm run copiar-web && electron-builder --win nsis portable --publish never && node scripts/firmar-actualizacion.js"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "45.4.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "es.securechat.desktop",
    "productName": "SecureChat",
    "copyright": "Alejandro Zapata",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "actualizaciones.js",
      "actualizaciones-firma.js",
      "icon.png",
      "app/**/*",
      "!app/sw.js"
    ],
    "asar": true,
    "afterPack": "scripts/fusibles.js",
    "win": {
      "icon": "icon.png",
      "artifactName": "SecureChat-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SecureChat",
      "artifactName": "SecureChat-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SecureChat-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ZaperMaster",
        "repo": "securechat",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
